rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cards collection
    match /cards/{cardId} {
      // Anyone can read cards
      allow read: if true;

      // Create with schema validation; ownerUid stamp must be honest
      allow create: if
        isValidCardDocument(request.resource.data)
        && (!('ownerUid' in request.resource.data)
            || (request.auth != null && request.resource.data.ownerUid == request.auth.uid));

      // Owner-only update; ownerUid/id/createdAt are immutable
      allow update: if
        request.auth != null
        && resource.data.get('ownerUid', null) == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidCardDocument(request.resource.data);

      // Owner-only delete
      allow delete: if
        request.auth != null
        && resource.data.get('ownerUid', null) == request.auth.uid;
    }

    // Community custom icons
    match /customIcons/{iconId} {
      allow read: if true;
      allow create: if isValidCustomIcon(request.resource.data);
      allow update, delete: if false;
    }

    // Reject all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isValidCardDocument(data) {
  return data.keys().hasAll(['cardType', 'layoutType', 'cardData', 'cardName'])
    && data.cardType is string
    && data.layoutType is string
    && data.cardData is map
    && data.cardName is string
    && data.cardName.size() <= 50
    && (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 50))
    && (!('tribe' in data) || (data.tribe is string && data.tribe.size() <= 40))
    // Enforce reasonable document size (Firestore 1MB limit, but we want much less)
    && request.resource.size() < 500000;
}

function isValidCustomIcon(data) {
  return data.keys().hasAll(['id', 'type', 'name', 'imageUrl', 'createdAt'])
    && data.id is string
    && data.type in ['set', 'trait', 'terra', 'aura', 'background']
    && data.name is string
    && data.name.size() <= 40
    && data.imageUrl is string
    && data.imageUrl.size() <= 2048
    && (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 50))
    && request.resource.size() < 10000;
}
